# Supabase Public Configuration
VITE_SUPABASE_URL=https://igqcyadhqaqxeqlmjoqo.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=a4qihner

# Server-only Cloudinary secrets (jangan gunakan prefix VITE_)
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Server aliases used by Vercel Functions (same Supabase project)
SUPABASE_URL=https://igqcyadhqaqxeqlmjoqo.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key
# Server-only. Never prefix with VITE_ and never expose this value in browser code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Environment
VITE_APP_ENV=local

# Feature Flags
VITE_ENABLE_PRODUCT_LAUNCH=true
VITE_ENABLE_CATALOG=false
VITE_ENABLE_ATTENDANCE=true
VITE_ENABLE_POS_SELLER=false
